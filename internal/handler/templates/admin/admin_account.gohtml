{{define "content"}}

<h1>Profile settings</h1>

{{if .Notice}}<p class="notice">{{.Notice}}</p>{{end}}

<p class="muted">Signed in as <strong>{{.User.Display}}</strong>{{if ne .User.Display .User.Email}}
({{.User.Email}}){{end}} — {{.User.Role.Label}}.</p>

<h2>Password</h2>

{{if .Forced}}
<p class="notice problem">Your password was set by another administrator. Choose
one of your own before carrying on — nothing else in the admin is open until you
do.</p>
{{end}}

<form class="panel" method="post" action="/admin/account" autocomplete="off">
  {{template "csrf" .CSRFToken}}

  {{/*
    The account this password belongs to, for the browser's password manager:
    without a username field it cannot tell which stored credential is being
    updated, and it says so in the console. Hidden because the answer is not in
    question — you are signed in as this person — and the server ignores it.

    Deliberately not on the reset form on somebody else's page: a username there
    would invite the manager to save another person's credentials under this
    operator's profile.
  */}}
  <input type="text" name="username" value="{{.User.Email}}" autocomplete="username"
         hidden readonly>

  {{/*
    The current password is asked for even though the session is already
    authenticated: a CSRF token proves the request came from our form, not that
    the person at the keyboard is the one who owns the account. An unattended
    screen is the case this closes.
  */}}
  <div class="field">
    <label for="current_password">Current password</label>
    <input id="current_password" name="current_password" type="password" required
           autocomplete="current-password">
    {{template "err" index .PasswordErrors "current_password"}}
  </div>
  <div class="field">
    <label for="password">New password</label>
    <input id="password" name="password" type="password" required
           autocomplete="new-password">
    {{template "err" index .PasswordErrors "password"}}
  </div>
  <div class="field">
    <label for="password_confirm">Repeat new password</label>
    <input id="password_confirm" name="password_confirm" type="password" required
           autocomplete="new-password">
    {{template "err" index .PasswordErrors "password_confirm"}}
  </div>

  <div class="actions">
    <button type="submit">Change password</button>
    <small>This ends every session, including this one, so you will sign in again
    with the new password.</small>
  </div>
</form>

{{end}}

{{/*
  The public header's account menu, loaded by layouts/public.gohtml with htmx
  for a browser holding an admin session (see accountMenu). The admin's own menu,
  with a way into the admin first.
*/}}
{{define "account_menu"}}
{{template "account_menu_open" .}}
    <a href="/admin/">Admin</a>
{{template "account_menu_close" .}}
{{end}}
