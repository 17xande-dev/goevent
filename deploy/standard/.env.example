# Copy to .env, fill in, and make it readable by you alone:
#
#   cp .env.example .env && chmod 600 .env
#
# This one file holds everything, credentials included. docs/deploy/standard.md
# walks through where each value comes from. Every setting the server takes is
# documented in .env.example at the repo root; anything from there can be added
# here too.

# --- The deploy ---
# The image tag to run: a release, never latest, so an update is a decision.
GOEVENT_VERSION=v1.0.0
# The store's hostname. Its DNS A record must point at this server before the
# first start — Caddy needs it to obtain a certificate. BASE_URL is derived
# from it.
DOMAIN=shop.example.com
# Let's Encrypt writes here about certificates it could not renew.
ACME_EMAIL=you@example.com

# --- The store ---
STORE_NAME=Your Store
CURRENCY=ZAR

# --- Database ---
# Generated, not chosen, and hex so it can sit inside a URL unescaped:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# Pending email encryption. Generate separately with openssl rand -hex 32.
# Back this key up with .env; do not change it while email jobs are pending.
SECRET_KEY=

# --- PayFast ---
# true until the three values below are your live ones. Required — there is no
# default here, on purpose.
PAYFAST_SANDBOX=true
# PayFast's published sandbox credentials. Replace all three before going live.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=jt7NOE43FZPn

# --- Product images: Cloudflare R2 ---
# The bucket must be publicly readable at BLOB_PUBLIC_BASE_URL — a custom
# domain connected to it, or its r2.dev address. The token is an R2 API token
# with Object Read & Write on this bucket alone.
# The endpoint is the host only. The R2 dashboard shows it as
# https://<account-id>.r2.cloudflarestorage.com — drop the https://, which
# BLOB_USE_TLS supplies. The same goes for DOWNLOAD_ENDPOINT below.
BLOB_ENDPOINT=<account-id>.r2.cloudflarestorage.com
BLOB_REGION=auto
BLOB_USE_TLS=true
BLOB_BUCKET=goevent-images
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=
BLOB_PUBLIC_BASE_URL=https://images.example.com

# --- Mail: SMTP ---
# Required for durable delivery of receipts and download links.
# Port 587 with starttls is right for almost every provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender; an address your provider lets you send as.
EMAIL_FROM=orders@example.com
# Optional: who gets a copy of each paid order.
ORDER_NOTIFY_EMAIL=

# --- Purchased files (digital products) ---
# A separate PRIVATE R2 bucket. Do not enable r2.dev or a public custom domain.
# The token must have Object Read & Write on this bucket.
DOWNLOAD_ENDPOINT=<account-id>.r2.cloudflarestorage.com
DOWNLOAD_REGION=auto
DOWNLOAD_USE_TLS=true
DOWNLOAD_BUCKET=goevent-downloads
DOWNLOAD_ACCESS_KEY_ID=
DOWNLOAD_SECRET_ACCESS_KEY=

# --- Optional ---
# Supply the first-admin setup token instead of reading a generated one from
# the logs. 32 characters minimum.
# SETUP_TOKEN=

# --- Theme (optional) ---
# compose.yaml mounts ./theme next to it at /theme, read-only. To use a theme, put
# it in that directory and uncomment these. Use these container paths, not host
# paths: the server only sees /theme. Restart after changing a file.
# TEMPLATE_DIR=/theme/templates
# STATIC_DIR=/theme/static
